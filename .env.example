# Copy to .env and adjust for your environment.

# Application
APP_ENV=development

# PostgreSQL (async driver)
DATABASE_URL=postgresql+asyncpg://shelflife:shelflife@localhost:5432/shelflife

# Redis
REDIS_URL=redis://localhost:6379/0

# Supabase (used to verify Auth JWTs via the project's JWKS endpoint)
SUPABASE_URL=
